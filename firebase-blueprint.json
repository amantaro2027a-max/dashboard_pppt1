{
  "entities": {
    "programs": {
      "title": "Program",
      "description": "Program latihan dan aktiviti rasmi IAB",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "namaProgram": { "type": "string", "maxLength": 400 },
        "kodProgram": { "type": "string", "maxLength": 120 },
        "jenisProgram": { "type": "string", "maxLength": 150 },
        "tarikhMula": { "type": "string", "maxLength": 30 },
        "tarikhTamat": { "type": "string", "maxLength": 30 },
        "tempoh": { "type": "string", "maxLength": 100 },
        "jumlahHari": { "type": "number" },
        "tempat": { "type": "string", "maxLength": 250 },
        "negeri": { "type": "string", "maxLength": 100 },
        "bilanganPeserta": { "type": "number" },
        "pengurusId": { "type": "string", "maxLength": 100 },
        "pengurusNama": { "type": "string", "maxLength": 200 },
        "pengurusBersamaId": { "type": "string", "maxLength": 100 },
        "pengurusBersamaNama": { "type": "string", "maxLength": 200 },
        "urusSetiaId": { "type": "string", "maxLength": 100 },
        "urusSetiaNama": { "type": "string", "maxLength": 200 },
        "kluster": { "type": "string", "maxLength": 200 },
        "pusat": { "type": "string", "maxLength": 250 },
        "jabatan": { "type": "string", "maxLength": 250 },
        "sumberKewangan": { "type": "string", "maxLength": 150 },
        "os21000": { "type": "number" },
        "os24000": { "type": "number" },
        "os27000": { "type": "number" },
        "os29000": { "type": "number" },
        "jumlahRm": { "type": "number" },
        "os21000Belanja": { "type": "number" },
        "os24000Belanja": { "type": "number" },
        "os27000Belanja": { "type": "number" },
        "os29000Belanja": { "type": "number" },
        "jumlahBelanjaRm": { "type": "number" },
        "os21000Penjimatan": { "type": "number" },
        "os24000Penjimatan": { "type": "number" },
        "os27000Penjimatan": { "type": "number" },
        "os29000Penjimatan": { "type": "number" },
        "jumlahPenjimatanRm": { "type": "number" },
        "statusProgram": { "type": "string", "maxLength": 100 },
        "tahun": { "type": "number" },
        "bulan": { "type": "number" },
        "catatan": { "type": "string", "maxLength": 2000 },
        "didaftarOleh": { "type": "string", "maxLength": 200 },
        "tarikhDaftar": { "type": "string", "maxLength": 64 },
        "rekodPindaan": { "type": "array" }
      },
      "required": ["namaProgram", "pusat", "jabatan", "statusProgram"]
    },
    "pegawai": {
      "title": "Pegawai",
      "description": "Senarai pegawai pengurus dan pengurus bersama",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "label": { "type": "string", "maxLength": 250 },
        "nama": { "type": "string", "maxLength": 200 },
        "pusat": { "type": "string", "maxLength": 250 },
        "jabatan": { "type": "string", "maxLength": 250 },
        "jawatan": { "type": "string", "maxLength": 150 },
        "emel": { "type": "string", "maxLength": 200 },
        "noHp": { "type": "string", "maxLength": 50 },
        "photoUrl": { "type": "string", "maxLength": 350000 }
      },
      "required": ["id", "nama"]
    },
    "admins": {
      "title": "Admin",
      "description": "Akaun pentadbir sistem dan jabatan (dilindungi Firebase Auth)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "authUid": { "type": "string", "maxLength": 128 },
        "firebaseAuthSynced": { "type": "boolean" },
        "password": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 200 },
        "pusat": { "type": "string", "maxLength": 250 },
        "jabatan": { "type": "string", "maxLength": 1000 },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "ADMIN"] },
        "levelId": { "type": "string", "maxLength": 64 },
        "allowedJabatans": { "type": "array" },
        "jabatanAccess": { "type": "object" },
        "allowedPages": { "type": "array" },
        "pageAccess": { "type": "object" },
        "emel": { "type": "string", "maxLength": 200 },
        "noHp": { "type": "string", "maxLength": 50 },
        "photoUrl": { "type": "string", "maxLength": 350000 },
        "isActive": { "type": "boolean" },
        "lastLoginAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name", "role", "createdAt"]
    },
    "auth_users": {
      "title": "AuthUserRbac",
      "description": "Pemetaan UID Firebase Auth kepada peranan dan kebenaran RBAC",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "adminId": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "ADMIN"] },
        "levelId": { "type": "string", "maxLength": 64 },
        "isActive": { "type": "boolean" },
        "pageAccess": { "type": "object" },
        "jabatanAccess": { "type": "object" },
        "allowedPages": { "type": "array" },
        "allowedJabatans": { "type": "array" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "adminId", "role", "isActive"]
    },
    "master_data": {
      "title": "MasterData",
      "description": "Konfigurasi kluster, pusat, jabatan, kewangan, kadar bajet, dan tetapan pemantauan",
      "type": "object",
      "properties": {
        "klusterList": { "type": "array" },
        "klusterMap": { "type": "object" },
        "pusatList": { "type": "array" },
        "jabatanMap": { "type": "object" },
        "sumberKewanganList": { "type": "array" },
        "statusProgramList": { "type": "array" },
        "jawatanList": { "type": "array" },
        "budgetRates": { "type": "object" },
        "monitoringSettings": { "type": "object" },
        "list": { "type": "array" }
      }
    },
    "subwaran": {
      "title": "Subwaran",
      "description": "Rekod agihan subwaran kepada PTJ",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "sumberKewangan": { "type": "string", "maxLength": 150 },
        "kluster": { "type": "string", "maxLength": 200 },
        "pusat": { "type": "string", "maxLength": 250 },
        "namaPtj": { "type": "string", "maxLength": 100 },
        "ptjLain": { "type": "string", "maxLength": 200 },
        "tarikhSubWaran": { "type": "string", "maxLength": 30 },
        "tahun": { "type": "number" },
        "os21000": { "type": "number" },
        "os24000": { "type": "number" },
        "os27000": { "type": "number" },
        "os29000": { "type": "number" },
        "jumlah": { "type": "number" },
        "namaProgram": { "type": "string", "maxLength": 400 },
        "objektif": { "type": "string", "maxLength": 1000 },
        "pegawaiPic": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "sumberKewangan", "namaPtj", "namaProgram"]
    },
    "user_activity_logs": {
      "title": "UserActivityLog",
      "description": "Log aktiviti pengguna masa nyata dalam zon masa Asia/Kuala_Lumpur (append-only)",
      "type": "object",
      "properties": {
        "log_id": { "type": "string", "maxLength": 128 },
        "user_id": { "type": "string", "maxLength": 128 },
        "user_name": { "type": "string", "maxLength": 200 },
        "user_email": { "type": "string", "maxLength": 200 },
        "user_role": { "type": "string", "maxLength": 100 },
        "action_type": { "type": "string", "maxLength": 64 },
        "module_name": { "type": "string", "maxLength": 150 },
        "activity_description": { "type": "string", "maxLength": 1000 },
        "record_id": { "type": "string", "maxLength": 200 },
        "ip_address": { "type": "string", "maxLength": 100 },
        "device_info": { "type": "string", "maxLength": 300 },
        "session_id": { "type": "string", "maxLength": 128 },
        "timestamp": { "type": "string", "maxLength": 64 },
        "malaysia_date": { "type": "string", "maxLength": 20 },
        "malaysia_datetime_display": { "type": "string", "maxLength": 64 },
        "duration_seconds": { "type": "number" },
        "status": { "type": "string", "enum": ["SUCCESS", "FAILED", "BLOCKED"] }
      },
      "required": ["log_id", "user_id", "action_type", "module_name", "timestamp", "status"]
    },
    "security_alerts": {
      "title": "SecurityAlert",
      "description": "Amaran keselamatan automatik bagi aktiviti mencurigakan",
      "type": "object",
      "properties": {
        "alert_id": { "type": "string", "maxLength": 128 },
        "rule_code": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 },
        "severity": { "type": "string", "enum": ["Critical", "High", "Medium", "Low"] },
        "status": { "type": "string", "enum": ["New", "Under Review", "Resolved"] },
        "user_id": { "type": "string", "maxLength": 128 },
        "user_name": { "type": "string", "maxLength": 200 },
        "module_name": { "type": "string", "maxLength": 150 },
        "trigger_count": { "type": "number" },
        "related_log_ids": { "type": "array" },
        "timestamp": { "type": "string", "maxLength": 64 },
        "malaysia_datetime_display": { "type": "string", "maxLength": 64 },
        "reviewed_by": { "type": "string", "maxLength": 200 },
        "reviewed_at": { "type": "string", "maxLength": 64 }
      },
      "required": ["alert_id", "rule_code", "title", "severity", "status", "timestamp"]
    },
    "jabatan_allocations": {
      "title": "JabatanAllocation",
      "description": "Rekod agihan peruntukan daripada Ketua Pusat kepada Jabatan mengikut pecahan OS",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "pusat": { "type": "string", "maxLength": 250 },
        "jabatan": { "type": "string", "maxLength": 250 },
        "tahun": { "type": "number" },
        "tarikh": { "type": "string", "maxLength": 30 },
        "os21000": { "type": "number" },
        "os24000": { "type": "number" },
        "os27000": { "type": "number" },
        "os29000": { "type": "number" },
        "jumlah": { "type": "number" },
        "catatan": { "type": "string", "maxLength": 1000 },
        "diagihkanOlehId": { "type": "string", "maxLength": 128 },
        "diagihkanOlehNama": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "createdAtMs": { "type": "number" },
        "serverCreatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "pusat", "jabatan", "tahun", "tarikh", "os21000", "os24000", "os27000", "os29000", "jumlah", "diagihkanOlehId", "diagihkanOlehNama", "createdAt"]
    },
    "jabatan_pullbacks": {
      "title": "JabatanPullback",
      "description": "Rekod penarikan semula (TARIK) oleh Ketua Pusat atau pemulangan (PULANGKAN) oleh Ketua Jabatan",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "pusat": { "type": "string", "maxLength": 250 },
        "jabatan": { "type": "string", "maxLength": 250 },
        "tahun": { "type": "number" },
        "jenisTindakan": { "type": "string", "enum": ["TARIK", "PULANGKAN"] },
        "sumberBaki": { "type": "string", "enum": ["ASAL", "PENJIMATAN"] },
        "tarikh": { "type": "string", "maxLength": 30 },
        "os21000": { "type": "number" },
        "os24000": { "type": "number" },
        "os27000": { "type": "number" },
        "os29000": { "type": "number" },
        "jumlah": { "type": "number" },
        "catatan": { "type": "string", "maxLength": 1000 },
        "dilakukanOlehId": { "type": "string", "maxLength": 128 },
        "dilakukanOlehNama": { "type": "string", "maxLength": 200 },
        "dilakukanOlehPeranan": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "pusat", "jabatan", "tahun", "jenisTindakan", "sumberBaki", "tarikh", "os21000", "os24000", "os27000", "os29000", "jumlah", "dilakukanOlehId", "dilakukanOlehNama", "dilakukanOlehPeranan", "createdAt"]
    },
    "pusat_jabatan_messages": {
      "title": "PusatJabatanMessage",
      "description": "Komunikasi perbincangan antara Ketua Pusat dan Ketua Jabatan berkaitan baki, penarikan dan pemulangan",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "pusat": { "type": "string", "maxLength": 250 },
        "jabatan": { "type": "string", "maxLength": 250 },
        "tahun": { "type": "number" },
        "pengirimId": { "type": "string", "maxLength": 128 },
        "pengirimNama": { "type": "string", "maxLength": 200 },
        "pengirimLevel": { "type": "string", "maxLength": 64 },
        "mesej": { "type": "string", "maxLength": 2000 },
        "topik": { "type": "string", "enum": ["BAKI", "PENARIKAN", "PEMULANGAN", "AGIHAN", "UMUM"] },
        "createdAt": { "type": "string", "maxLength": 64 },
        "createdAtMs": { "type": "number" },
        "serverCreatedAt": { "type": "string", "format": "date-time" },
        "malaysiaDisplay": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "pusat", "jabatan", "tahun", "pengirimId", "pengirimNama", "pengirimLevel", "mesej", "createdAt", "malaysiaDisplay"]
    }
  },
  "firestore": {
    "/programs/{programId}": {
      "schema": { "$ref": "#/entities/programs" },
      "description": "Program latihan dan aktiviti IAB"
    },
    "/pegawai/{pegawaiId}": {
      "schema": { "$ref": "#/entities/pegawai" },
      "description": "Direktori pegawai IAB"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/admins" },
      "description": "Profil dan kebenaran pentadbir"
    },
    "/auth_users/{uid}": {
      "schema": { "$ref": "#/entities/auth_users" },
      "description": "Pemetaan peranan Firebase Auth UID untuk penguatkuasaan rules"
    },
    "/master_data/{docId}": {
      "schema": { "$ref": "#/entities/master_data" },
      "description": "Konfigurasi induk sistem dan tetapan pemantauan"
    },
    "/subwaran/{subwaranId}": {
      "schema": { "$ref": "#/entities/subwaran" },
      "description": "Rekod agihan subwaran"
    },
    "/user_activity_logs/{logId}": {
      "schema": { "$ref": "#/entities/user_activity_logs" },
      "description": "Log audit aktiviti pengguna"
    },
    "/security_alerts/{alertId}": {
      "schema": { "$ref": "#/entities/security_alerts" },
      "description": "Amaran keselamatan automatik"
    },
    "/jabatan_allocations/{allocationId}": {
      "schema": { "$ref": "#/entities/jabatan_allocations" },
      "description": "Rekod agihan peruntukan Ketua Pusat kepada Jabatan"
    },
    "/jabatan_pullbacks/{pullbackId}": {
      "schema": { "$ref": "#/entities/jabatan_pullbacks" },
      "description": "Rekod penarikan semula dan pemulangan baki Jabatan"
    },
    "/pusat_jabatan_messages/{messageId}": {
      "schema": { "$ref": "#/entities/pusat_jabatan_messages" },
      "description": "Mesej komunikasi antara Ketua Pusat dan Ketua Jabatan"
    }
  }
}

